<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: never back up or transfer the session cookie (NetworkModule.COOKIE_STORE_FILE)
     or the local database, which caches the user's sightings and is rebuilt from the server. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/cookies.preferences_pb" />
        <exclude domain="database" path="birddex.db" />
        <exclude domain="database" path="birddex.db-wal" />
        <exclude domain="database" path="birddex.db-shm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/cookies.preferences_pb" />
        <exclude domain="database" path="birddex.db" />
        <exclude domain="database" path="birddex.db-wal" />
        <exclude domain="database" path="birddex.db-shm" />
    </device-transfer>
</data-extraction-rules>
