<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: back up app data, but never the session cookie (NetworkModule.COOKIE_STORE_FILE). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/cookies.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/cookies.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
